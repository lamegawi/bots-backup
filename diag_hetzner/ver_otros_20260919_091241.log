== Su servicio systemd ==
[Unit]
Description=Bot Polymarket Trump Truth Social posts
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/polymarket.env
EnvironmentFile=-/etc/default/poly-trump
Type=simple
User=root
WorkingDirectory=/opt/polymarket/bot-polymarket-trump
ExecStart=/usr/bin/python3 bot_semanal.py --loop --intervalo 15 --modo real
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=Bot Polymarket Zelenskyy SEMANAL
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/polymarket/bot-polymarket-zelenskyy
EnvironmentFile=/etc/polymarket.env
ExecStart=/usr/bin/python3 bot_semanal.py --loop --intervalo 5 --excel --modo real
Restart=always
TimeoutStartSec=300
RestartSec=30
StandardOutput=append:/var/log/poly-zelenskyy.log
StandardError=append:/var/log/poly-zelenskyy.log

[Install]
WantedBy=multi-user.target
