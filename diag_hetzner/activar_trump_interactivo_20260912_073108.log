[Unit]
Description=Bot Polymarket Trump Truth Social posts
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/poly-trump
Type=simple
User=root
WorkingDirectory=/opt/polymarket/bot-polymarket-trump
ExecStart=/usr/bin/python3 bot_semanal.py --loop --intervalo 15 --modo real
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

