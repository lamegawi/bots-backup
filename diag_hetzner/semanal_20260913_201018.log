     # /etc/systemd/system/poly-gestor.service
     [Unit]
     Description=Gestor de cierre anticipado de posiciones Polymarket
     After=network-online.target
     Wants=network-online.target
     StartLimitIntervalSec=0
     
     [Service]
     Type=simple
     User=root
     WorkingDirectory=/opt/polymarket
     EnvironmentFile=/etc/polymarket.env
     ExecStart=/usr/bin/python3 /opt/polymarket/gestionar_posiciones.py --loop 5
     Restart=always
     RestartSec=30
     StandardOutput=append:/var/log/poly-gestor.log
     StandardError=append:/var/log/poly-gestor.log
     SyslogIdentifier=poly-gestor
     
     [Install]
     WantedBy=multi-user.target
