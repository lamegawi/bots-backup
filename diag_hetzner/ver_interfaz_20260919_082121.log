== ¿El servicio poly-elon carga /etc/polymarket.env? ==
[Unit]
Description=Bot Polymarket Elon 48h (v1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/polymarket/bot-polymarket-elon
EnvironmentFile=/etc/polymarket.env
ExecStart=/usr/bin/python3 bot.py --loop --intervalo 5 --excel --modo real
Restart=always
TimeoutStartSec=300
RestartSec=30
StandardOutput=append:/var/log/poly-elon.log
StandardError=append:/var/log/poly-elon.log

[Install]
WantedBy=multi-user.target

