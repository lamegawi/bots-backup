   143	def parse_bin(titulo):
   144	    """'<20' → (0,19) · '20-39' → (20,39) · '1000+' → (1000,∞)"""
   145	    t = (titulo or "").strip()
   146	    m = re.match(r"^<(\d+)$", t)
   147	    if m:
   148	        return (0, int(m.group(1)) - 1)
   149	    m = re.match(r"^(\d+)\s*[-–]\s*(\d+)$", t)
   150	    if m:
   151	        return (int(m.group(1)), int(m.group(2)))
   152	    m = re.match(r"^(\d+)\+$", t)
   153	    if m:
   154	        return (int(m.group(1)), float("inf"))
   155	    return None
   156	
   157	
   158	def parse_ventana(desc, end_iso, titulo):
   159	    """Ventana del mercado:
   160	    - 48h/semanal: 'from August 15 12:00 PM ET to August 17, 2026 12:00 PM ET'.
   161	    - MENSUSAL: 'during the month of August 2026' → día 1 00:00 ET al día 1
   162	      del mes siguiente 00:00 ET (fin = endDate cuando existe).
   163	    Devuelve (inicio_utc, fin_utc) o None."""
   164	    # ---- mensual: "the month of August 2026" en la descripción/título
   165	    m = re.search(r"month of ([A-Z][a-z]+) (\d{4})", desc or "")
   166	    if not m:
   167	        m = re.search(r"in ([A-Z][a-z]+) (\d{4})", titulo or "")
   168	    if m:
   169	        mes, anio = m.group(1), int(m.group(2))
   170	        if mes in MESES:
   171	            inicio = datetime(anio, MESES[mes], 1, 0, 0, tzinfo=ET)
   172	            if end_iso:
   173	                fin = datetime.fromisoformat(end_iso.replace("Z", "+00:00")).astimezone(ET)
   174	            else:
   175	                nxt = anio + 1 if MESES[mes] == 12 else anio
   176	                nm = 1 if MESES[mes] == 12 else MESES[mes] + 1
   177	                fin = datetime(nxt, nm, 1, 0, 0, tzinfo=ET)
   178	            if inicio < fin:
   179	                return inicio, fin
   180	            return None
   181	    # ---- 48h / semanal: "from ... to ..."
   182	    pat = re.compile(
   183	        r"from ([A-Z][a-z]+) (\d{1,2})(?:,? (\d{4}))? (\d{1,2}):(\d{2}) ([AP]M) ET "
   184	        r"to ([A-Z][a-z]+) (\d{1,2})(?:,? (\d{4}))? (\d{1,2}):(\d{2}) ([AP]M) ET")
   185	    mm = pat.search(desc or "")
   186	    if not mm:
   187	        return None
   188	
   189	    def to_dt(month, day, year, hh, mm2, ap):
   190	        anio = int(year) if year else int(end_iso[:4])
   191	        h = int(hh) % 12 + (12 if ap == "PM" else 0)
   192	        return datetime(anio, MESES[month], int(day), h, int(mm2), tzinfo=ET)
   193	
   194	    inicio = to_dt(mm.group(1), mm.group(2), mm.group(3), mm.group(4), mm.group(5), mm.group(6))
   195	    fin = to_dt(mm.group(7), mm.group(8), mm.group(9), mm.group(10), mm.group(11), mm.group(12))
   196	    if inicio >= fin:
   197	        return None
   198	    return inicio, fin
   199	
