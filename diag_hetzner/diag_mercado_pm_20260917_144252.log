    43	VISTAS = "ventanas_vistas.json"
    44	MESES = {"January": 1, "February": 2, "March": 3, "April": 4, "May": 5, "June": 6,
    45	         "July": 7, "August": 8, "September": 9, "October": 10, "November": 11,
    46	         "December": 12}
    47	MESES_NOMBRE = {1: "january", 2: "february", 3: "march", 4: "april", 5: "may",
    48	                6: "june", 7: "july", 8: "august", 9: "september", 10: "october",
