    77	def _detectar_nuevas(res):
    78	    """Compara las ventanas del JSON con las ya vistas. Devuelve la lista de
    79	    ventanas ABIERTAS nuevas (nunca vistas antes) y actualiza el registro.
    80	    Las ventanas que ya no están abiertas se marcan como resueltas (no se
    81	    volverán a sondear)."""
    82	    vistas = _cargar_vistas()
    83	    nuevas = []
    84	    ahora = datetime.now(timezone.utc)
    85	    for mk in res:
    86	        slug = mk.get("slug") or ""
    87	        if not slug:
    88	            continue
    89	        if mk["cerrado"] or (mk.get("fin_iso") and datetime.fromisoformat(mk["fin_iso"]) < ahora):
    90	            vistas[slug] = {"cerrada": True, "primera_vista": vistas.get(slug, {}).get("primera_vista", datetime.now(timezone.utc).isoformat())}
    91	            continue
    92	        if slug not in vistas:
    93	            vistas[slug] = {"cerrada": False, "primera_vista": datetime.now(timezone.utc).isoformat()}
    94	            nuevas.append(mk)
    95	    _guardar_vistas(vistas)
    96	    return nuevas
