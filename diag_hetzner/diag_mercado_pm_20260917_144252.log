   201	def procesar(events):
   202	    res = []
   203	    for ev in events:
   204	        bins = []
   205	        for m in ev.get("markets", []):
   206	            bin_ = parse_bin(m.get("groupItemTitle") or "")
   207	            if not bin_:
   208	                continue
   209	            try:
   210	                precios = json.loads(m.get("outcomePrices") or "[]")
   211	            except Exception:
   212	                continue
   213	            if len(precios) < 2:
   214	                continue
   215	            try:
   216	                px = float(precios[0])
   217	                pn = float(precios[1]) if precios[1] not in (None, "") else 1 - px
   218	            except Exception:
   219	                continue
   220	            cuota_yes = 1 / px if px > 0 else None
   221	            cuota_no = 1 / (1 - px) if px < 1 else None
   222	            try:
   223	                volumen = float(m.get("volume") or 0)
   224	            except Exception:
   225	                volumen = 0
   226	            bins.append({"titulo": m.get("groupItemTitle"), "lo": bin_[0],
   227	                         "hi": bin_[1], "precio_yes": round(px, 4),
   228	                         "precio_no": round(pn, 4), "cuota_yes": cuota_yes,
   229	                         "cuota_no": cuota_no, "volumen": volumen})
   230	        if not bins:
   231	            continue
   232	        ventana = parse_ventana(ev.get("description"), ev.get("endDate") or "",
   233	                                ev.get("title") or "")
   234	        dur_h = None
   235	        tipo = "otro"
   236	        if ventana:
   237	            dur_h = (ventana[1] - ventana[0]).total_seconds() / 3600
   238	            if abs(dur_h - 48) < 2:
   239	                tipo = "48h"
   240	            elif abs(dur_h - 168) < 8:
   241	                tipo = "semanal"
   242	            elif 660 < dur_h < 780:            # 28-32 días → mensual
   243	                tipo = "mensual"
   244	            else:
   245	                tipo = "otro"
   246	        res.append({
   247	            "id": ev.get("id"), "titulo": ev.get("title"), "slug": ev.get("slug"),
   248	            "cerrado": bool(ev.get("closed")), "volumen": ev.get("volume"),
   249	            "endDate": ev.get("endDate"),
   250	            "inicio_iso": ventana[0].isoformat() if ventana else None,
   251	            "fin_iso": ventana[1].isoformat() if ventana else None,
   252	            "duracion_h": dur_h, "tipo": tipo, "bins": bins})
   253	    res.sort(key=lambda x: (x["cerrado"], x["fin_iso"] or ""))
   254	    return res
   255	
   256	
   257	def actualizar_mercado():
   258	    """Descarga, procesa y guarda mercado_activo.json. Devuelve la lista.
   259	    Si detecta ventanas NUEVAS (recién creadas), las añade al registro y
   260	    avisa por ntfy (🆕 Nueva ventana)."""
   261	    res = procesar(fetch_events())
   262	    with open(SALIDA, "w", encoding="utf-8") as f:
   263	        json.dump({"actualizado": datetime.now(timezone.utc).isoformat(),
   264	                   "mercados": res}, f, ensure_ascii=False, indent=1)
   265	    nuevas = _detectar_nuevas(res)
   266	    for mk in nuevas:
   267	        try:
   268	            import notificar
   269	            notificar.ventana_nueva(mk)
   270	        except Exception:
   271	            pass
   272	    return res
