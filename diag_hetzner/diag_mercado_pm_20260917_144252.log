    68	def _guardar_vistas(vistas):
    69	    try:
    70	        with open(VISTAS, "w", encoding="utf-8") as f:
    71	            json.dump({"actualizado": datetime.now(timezone.utc).isoformat(),
    72	                       "vistas": vistas}, f, ensure_ascii=False, indent=1)
    73	    except Exception:
    74	        pass
