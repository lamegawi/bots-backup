    99	def fetch_events():
   100	    """Búsqueda pública + enumeración de slugs de TODAS las ventanas
   101	    posibles (48h día a día, semanales día a día, mensuales mes a mes).
   102	    Así, cuando una ventana termina y Polymarket crea la siguiente, esta
   103	    se detecta en la misma pasada (sin importar el día en que la creen).
   104	
   105	    Solo se sondean los slugs que la búsqueda pública no devuelve y que
   106	    no están registrados como resueltos (eficiencia: ~0-3 requests/pasada
   107	    en condiciones normales)."""
   108	    d = curl(GAMMA)
   109	    eventos = [e for e in d.get("events", []) if "tweets" in (e.get("title") or "").lower()]
   110	    vistos = {e.get("id"): e for e in eventos if e.get("id")}
   111	    vistos_slugs = {e.get("slug"): e for e in eventos if e.get("slug")}
   112	    conocidas = _cargar_vistas()
   113	
   114	    hoy = datetime.now(timezone.utc).date()
   115	    slugs = set()
   116	    for i in range(-2, 16):            # 48h: desde hace 2 días hasta +15 (día a día)
   117	        d1 = hoy + timedelta(days=i)
   118	        d2 = d1 + timedelta(days=2)
   119	        slugs.add(f"elon-musk-of-tweets-{MESES_NOMBRE[d1.month]}-{d1.day}-{MESES_NOMBRE[d2.month]}-{d2.day}")
   120	    for i in range(-7, 22):            # semanales: desde hace 7 días hasta +21 (día a día)
   121	        d1 = hoy + timedelta(days=i)
   122	        d2 = d1 + timedelta(days=7)
   123	        slugs.add(f"elon-musk-of-tweets-{MESES_NOMBRE[d1.month]}-{d1.day}-{MESES_NOMBRE[d2.month]}-{d2.day}")
   124	    for delta in (-2, -1, 0, 1, 2, 3):  # mensuales: 2 atrás, actual y 3 futuros
   125	        d1 = hoy + timedelta(days=31 * delta)
   126	        slugs.add(f"elon-musk-of-tweets-{MESES_NOMBRE[d1.month]}-{d1.year}")
   127	
   128	    for s in sorted(slugs):
   129	        if s in vistos_slugs:          # ya lo trae la búsqueda pública
   130	            continue
   131	        info = conocidas.get(s)
   132	        if info and info.get("cerrada"):
   133	            continue                   # resuelta: no volverá a abrirse
   134	        try:
   135	            data = curl(f"https://gamma-api.polymarket.com/events?slug={s}")
   136	            if isinstance(data, list) and data and not data[0].get("closed"):
   137	                vistos.setdefault(data[0].get("id"), data[0])
   138	        except Exception:
   139	            pass
   140	    return list(vistos.values())
