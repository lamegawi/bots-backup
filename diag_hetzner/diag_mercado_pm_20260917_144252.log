    52	def curl(url):
    53	    r = subprocess.run(["curl", "-s", "--max-time", "40", url],
    54	                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    55	    if r.returncode != 0 or not r.stdout.strip():
    56	        raise RuntimeError("curl falló o respuesta vacía")
    57	    return json.loads(r.stdout)
    58	
