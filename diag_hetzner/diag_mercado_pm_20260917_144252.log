   275	def main():
   276	    ap = argparse.ArgumentParser(description="Mercados Polymarket de tweets de @elonmusk")
   277	    ap.add_argument("--json", action="store_true", help="salida solo JSON")
   278	    args = ap.parse_args()
   279	    res = actualizar_mercado()
   280	    if args.json:
   281	        print(json.dumps(res, ensure_ascii=False, indent=1))
   282	        return
   283	    print(f"Mercados Polymarket «Elon Musk # tweets»  (actualizado: "
   284	          f"{datetime.now(ET).strftime('%Y-%m-%d %H:%M %Z')})")
   285	    print("=" * 92)
   286	    for mk in res:
   287	        estado = "CERRADO" if mk["cerrado"] else "ABIERTO"
   288	        print(f"\n■ {mk['titulo']}  [{estado}]  tipo: {mk['tipo']}  "
   289	              f"volumen: ${mk['volumen']:,.0f}")
   290	        if mk.get("inicio_iso"):
   291	            print(f"   ventana: {mk['inicio_iso']} → {mk['fin_iso']} "
   292	                  f"({mk['duracion_h']:.0f} h)")
   293	        print(f"   {'bin':<10}{'precio YES':>12}{'cuota YES':>12}{'cuota NO':>12}"
   294	              f"{'volumen':>12}")
   295	        for b in mk["bins"]:
   296	            cy = f"{b['cuota_yes']:.2f}" if b["cuota_yes"] else "—"
   297	            cn = f"{b['cuota_no']:.2f}" if b["cuota_no"] else "—"
   298	            marca = "  ← cuota ≥ 3" if (b["cuota_yes"] and b["cuota_yes"] >= 3) or \
   299	                    (b["cuota_no"] and b["cuota_no"] >= 3) else ""
   300	            print(f"   {b['titulo']:<10}{b['precio_yes']:>12.4f}{cy:>12}{cn:>12}"
   301	                  f"{b['volumen']:>12,.0f}{marca}")
   302	
