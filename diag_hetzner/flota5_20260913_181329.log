    40	def evaluar_senal(metricas, bin_lo, bin_hi, precio_yes, cuota_yes, cuota_no):
    41	    import senal
    42	    if not metricas:
    43	        return None, None, 0, "sin métricas"
    44	    avg7 = metricas['avg7']
    45	    ajuste = metricas['ajuste']
    46	    lam = 7 * avg7 * ajuste
    47	    p = senal.p_bin(bin_lo, bin_hi, lam)
    48	    decision, lado, motivo = senal.decidir_bin(p, precio_yes, cuota_yes, cuota_no)
    49	    if decision in ("APOSTAR YES", "APOSTAR NO"):
    50	        cuota = cuota_yes if lado == "YES" else cuota_no
    51	        ev = p * (cuota - 1) - (1 - p) if lado == "YES" else (1 - p) * (cuota - 1) - p
    52	        return decision, lado, ev, motivo
    53	    return None, None, 0, motivo
