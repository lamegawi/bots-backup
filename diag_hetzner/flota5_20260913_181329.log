   114	def inyectar_proxy_sdk(proxy_url=None):
   115	    """Inyecta proxy en el cliente httpx del SDK. Patrón del agente de combos."""
   116	    import os, httpx
   117	    if proxy_url is None:
   118	        proxy_url = os.environ.get("HTTP_PROXY") or os.environ.get("HTTPS_PROXY") or "http://100.83.57.99:8888"
   119	    for k in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
   120	              "http_proxy", "https_proxy", "all_proxy"):
   121	        os.environ[k] = proxy_url
   122	    try:
   123	        from py_clob_client.http_helpers import helpers as _hh
   124	    except ImportError:
   125	        log("  ⚠️ no se pudo importar helpers del SDK")
   126	        return False
   127	    for kw in ({"http2": True, "proxy": proxy_url},
   128	               {"http2": True, "proxies": {"all://": proxy_url}},
   129	               {"http2": True, "proxies": proxy_url},
   130	               {"proxy": proxy_url},
   131	               {"proxies": {"all://": proxy_url}}):
   132	        try:
   133	            _hh._http_client = httpx.Client(**kw)
   134	            log(f"  ✅ proxy SDK inyectado con {kw}")
   135	            return True
   136	        except (TypeError, ImportError):
   137	            continue
   138	    log("  ❌ no se pudo inyectar proxy en SDK")
   139	    return False
