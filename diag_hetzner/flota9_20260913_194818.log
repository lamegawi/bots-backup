   328	def ventana_ocupada(slug, bin_titulo, ahora=None):
   329	    """Devuelve el nombre del bot que ya tiene apuesta en esa ventana/bin,
   330	    o None si está libre. Expira cuando termina la ventana."""
   331	    ahora = ahora or datetime.now(timezone.utc)
   332	    d = _leer_lock()
   333	    clave = f"{slug}|{bin_titulo}"
   334	    ent = d.get(clave)
   335	    if not ent:
   336	        return None
   337	    hasta = ent.get("hasta") or ""
   338	    if hasta:
   339	        try:
   340	            if datetime.fromisoformat(hasta).astimezone(timezone.utc) < ahora:
   341	                return None
   342	        except Exception:
   343	            pass
   344	    return ent.get("bot") or "?"
   345	
   346	
   347	def marcar_ventana(slug, bin_titulo, fin_iso):
   348	    d = _leer_lock()
   349	    d[f"{slug}|{bin_titulo}"] = {"bot": BOT_NOMBRE, "hasta": fin_iso or "",
   350	                                  "ts": time.time()}
   351	    _guardar_lock(d)
   352	
   353	
   354	def liberar_ventana(slug, bin_titulo):
   355	    d = _leer_lock()
   356	    d.pop(f"{slug}|{bin_titulo}", None)
   357	    _guardar_lock(d)
