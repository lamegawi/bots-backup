   241	def verificar_saldo_usdc(client):
   242	    """Devuelve (saldo, allowance) o (None, None) si no se puede consultar.
   243	    Compatible con py-clob-client 0.34.x: get_balance_allowance espera un
   244	    objeto BalanceAllowanceParams (dataclass), no un dict.
   245	    IMPORTANTE: la API CLOB consulta el saldo del FIRMANTE (signer), que en
   246	    cuentas con deposit wallet NO es donde está el dinero. La fuente de
   247	    verdad es el saldo on-chain del wallet_address (ver saldo_usdc_onchain)."""
   248	    try:
   249	        from py_clob_client_v2.clob_types import BalanceAllowanceParams, AssetType
   250	        r = client.get_balance_allowance(
   251	            BalanceAllowanceParams(asset_type=AssetType.COLLATERAL))
   252	        # el balance viene en unidades base del token (6 decimales: pUSD/USDC)
   253	        return float(r.get("balance", 0)) / 1e6, float(r.get("allowance", 0))
   254	    except Exception as e:
   255	        print(f"  [aviso] no se pudo consultar saldo USDC vía CLOB: {e}")
   256	        return None, None
