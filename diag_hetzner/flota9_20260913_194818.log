   626	def vigilar_orden_pendiente(estado, cfg):
   627	    """Comprueba en cada pasada si la orden pendiente se llenó.
   628	    - Llenada → notifica ✅ (apuesta activa) y deja de vigilar.
   629	    - > FILL_TIMEOUT_MIN sin llenar → cancela y notifica ⚠️.
   630	    - Sigue pendiente → solo informa en log (el bot continúa operando)."""
   631	    act = estado.get("activa") or {}
   632	    # si hay order_id y no está marcado como ya-llenado, se vigila
   633	    if not act.get("order_id") or act.get("pendiente") is False:
   634	        return
   635	    try:
   636	        from py_clob_client_v2.clob_types import OrderPayload
   637	        client = get_client()
   638	        detalle = client.get_order(act["order_id"])
   639	        if detalle is None:
   640	            # La orden ya no existe en CLOB: se canceló o expiró sin llenarse.
   641	            liberar_ventana(act.get("slug", ""), act.get("bin_titulo", ""))
   642	            estado["activa"] = None
   643	            guardar_estado(estado)
   644	            print(f"  ⚠️ Orden {act.get('bin_titulo')} {act.get('lado')} ya no existe "
   645	                  f"en CLOB (cancelada/expiró). Estado limpiado y ventana liberada.")
   646	            try:
   647	                notificar.enviar(
   648	                    f"⚠️ Orden cancelada por Polymarket (no llenada)\n"
   649	                    f"Bin {act.get('bin_titulo')} · {act.get('lado')} @ {act.get('precio', 0):.3f}\n"
   650	                    f"Se liberó la ventana para volver a intentarlo.",
   651	                    titulo="⚠️ Orden cancelada por el exchange",
   652	                    etiqueta="warning")
   653	            except Exception:
   654	                pass
   655	            return
   656	        st = (detalle.get("status") or "").lower()
   657	        sz = float(detalle.get("size_matched", 0) or 0)
   658	        llenada = st in ("matched", "filled") or sz > 0
   659	        if llenada:
   660	            act["pendiente"] = False
   661	            act.pop("order_id", None)
   662	            act.pop("fecha_orden_ts", None)
   663	            guardar_estado(estado)
   664	            print(f"  ✅ Orden REAL LLENADA (apuesta activa): {act['bin_titulo']} "
   665	                  f"{act['lado']} @ {act['precio']:.3f}")
   666	            try:
   667	                notificar.enviar(
   668	                    f"✅ ORDEN REAL LLENADA (apuesta activa)\n"
   669	                    f"Mercado: {act['slug']}\nBin {act['bin_titulo']} · {act['lado']} "
   670	                    f"@ {act['precio']:.3f} (cuota {act['cuota']:.2f})\n"
   671	                    f"Stake ${act['stake']:.2f} · resuelve: {str(act.get('ventana_fin','?'))[:16]}\n"
   672	                    f"Tweets en la ventana: {notificar.tweets_activa(act)}\n"
   673	                    f"{saldo_ntfy.saldo_real_texto()}",
   674	                    titulo="[REAL] ✅ Apuesta EJECUTADA",
   675	                    etiqueta="white_check_mark")
   676	            except Exception as e:
   677	                print(f"  [aviso] notif llenada: {e}")
   678	        else:
   679	            creada = act.get("fecha_orden_ts") or time.time()
   680	            edad_min = (time.time() - creada) / 60
   681	            if edad_min >= FILL_TIMEOUT_MIN:
   682	                try:
   683	                    client.cancel_order(OrderPayload(orderID=act["order_id"]))
   684	                    print(f"  Orden cancelada (no se llenó en {FILL_TIMEOUT_MIN} min).")
   685	                except Exception as e:
   686	                    print(f"  [aviso] cancel: {e}")
   687	                try:
   688	                    notificar.enviar(
   689	                        f"⚠️ Orden REAL cancelada (no llenada en {FILL_TIMEOUT_MIN} min)\n"
   690	                        f"{act['bin_titulo']} {act['lado']} @ {act['precio']:.3f}",
   691	                        titulo="⚠️ Orden cancelada",
   692	                        etiqueta="warning")
   693	                except Exception:
   694	                    pass
   695	                liberar_ventana(act.get("slug", ""), act.get("bin_titulo", ""))
   696	                estado["activa"] = None
   697	                guardar_estado(estado)
   698	            else:
   699	                print(f"  ⏳ Orden pendiente: {act['bin_titulo']} {act['lado']} "
   700	                      f"@ {act['precio']:.3f} ({edad_min:.0f}/{FILL_TIMEOUT_MIN} min)")
   701	    except Exception as e:
   702	        print(f"  [aviso] vigilar orden: {e}")
   703	
   704	def pasada_real(dry=False, actualizar=False, excel=False):
   705	    """Una pasada completa de trading real."""
   706	    cfg = cargar_config()
   707	    estado = cargar_estado()
   708	    print(f"[{datetime.now(ET).strftime('%Y-%m-%d %H:%M %Z')}] Trading REAL "
   709	          f"{'(SECO)' if dry else ''} · saldo ${estado['saldo']:.2f} · "
   710	          f"paso {estado['paso']}")
   711	    if estado.get("activa"):
   712	        act = estado["activa"]
   713	        # registrar la ventana en el lock compartido (evita duplicados entre bots)
   714	        marcar_ventana(act.get("slug", ""), act.get("bin_titulo", ""),
   715	                       act.get("ventana_fin", ""))
   716	        resolver(estado, fee_pct=cfg.get("fee_pct", 0.0))
   717	        # FIXWIN_ARENA: reposicionamiento si el bin activo pierde probabilidad
   718	        if estado.get("activa"):
   719	            fixwin_check(estado, cfg, dry=dry)
   720	    if not estado.get("activa"):
   721	        abrir(estado, dry=dry, actualizar=actualizar)
   722	    n = len(estado["historial"])
   723	    if n:
   724	        g = sum(1 for h in estado["historial"] if h["resultado"] == "G")
   725	        print(f"  Historial REAL: {n} apuestas · {g}G/{n-g}P · "
   726	              f"beneficio ${sum(h['beneficio'] for h in estado['historial']):+.2f}")
   727	    if excel and os.path.exists(HISTORIAL):
   728	        try:
   729	            from excel_historial import generar as gen_hist
   730	            ruta, anadidas, total = gen_hist(HISTORIAL,
   731	                                             salida="Historial_Operaciones.xlsx",
   732	                                             bankroll=cfg.get("bankroll", BANKROLL),
   733	                                             titulo_extra="trading REAL")
   734	            print(f"Excel historial: {ruta} (añadidas {anadidas}, total {total})")
   735	        except Exception as e:
   736	            print(f"  (no se pudo generar Excel: {e})")
   737	    return estado
