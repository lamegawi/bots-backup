   316	def _guardar_lock(d):
   317	    try:
   318	        ruta = _lock_path()
   319	        os.makedirs(os.path.dirname(ruta) or ".", exist_ok=True)
   320	        tmp = ruta + ".tmp"
   321	        with open(tmp, "w", encoding="utf-8") as f:
   322	            json.dump(d, f, ensure_ascii=False, indent=1)
   323	        os.replace(tmp, ruta)
   324	    except Exception as e:
   325	        print(f"  [aviso] lock: {e}")
