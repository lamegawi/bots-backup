   286	def _lock_path():
   287	    """Ruta del registro compartido: usa la configurada, o /home/bots (VM),
   288	    o si no es escribible, un archivo local (runners GitHub/PC)."""
   289	    p = os.environ.get("LOCK_APUESTAS", "")
   290	    if p:
   291	        return p
   292	    candidatos = ["/home/bots/apuestas_compartidas.json",
   293	                  "./apuestas_compartidas.json"]
   294	    for c in candidatos:
   295	        try:
   296	            os.makedirs(os.path.dirname(c) or ".", exist_ok=True)
   297	            with open(c, "a", encoding="utf-8") as f:
   298	                pass
   299	            return c
   300	        except Exception:
   301	            continue
   302	    return "./apuestas_compartidas.json"
   303	
