   820	
   821	def cerrar_anticipado(estado, motivo, dry=False):
   822	    """FIXWIN_ARENA: vende las shares activas (SELL en CLOB V2) y libera la ventana.
   823	    La orden se pone 10% bajo el precio actual de mercado para asegurar el fill."""
   824	    act = estado.get("activa")
   825	    if not act or act.get("pendiente"):
   826	        return False
   827	    token_id = act.get("token_id")
   828	    if not token_id or token_id == "TOKEN_DEMO":
   829	        print("  [FIXWIN] sin token_id real — no se puede vender")
   830	        return False
   831	    size = act.get("size") or round(act["stake"] / max(act["precio"], 0.001), 2)
   832	    # Precio de venta: precio actual del bin desde mercado_activo.json - 10%
   833	    precio_venta = max(0.01, round(act["precio"] * 0.85, 3))
   834	    try:
   835	        mks = json.load(open(mp.SALIDA, encoding="utf-8"))["mercados"]
   836	        mk_v = next((m for m in mks if m.get("slug") == act.get("slug")), None)
   837	        if mk_v:
   838	            b_v = next((b for b in mk_v.get("bins", []) if b["titulo"] == act["bin_titulo"]), None)
   839	            if b_v:
