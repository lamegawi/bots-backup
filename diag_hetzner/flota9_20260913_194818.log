   420	# ------------------------------------------------------------------ abrir
   421	def abrir(estado, dry=False, actualizar=False):
   422	    """Evalúa la señal y coloca una orden REAL (o la simula si dry=True)."""
   423	    cfg = cargar_config()
   424	    if not cfg.get("confirmado") and not dry:
   425	        print("  [BLOQUEADO] config_real.json no tiene 'confirmado': true. "
   426	              "Usa --simular para probar.")
   427	        return False
   428	    try:
   429	        datos = senal.cargar_csv("datos_elon.csv")
   430	    except SystemExit as e:
   431	        print(f"  (sin datos suficientes: {e})")
   432	        return False
   433	    m = senal.metricas(datos)
   434	    if actualizar:
   435	        try:
   436	            mp.actualizar_mercado()
   437	        except Exception as e:
   438	            print(f"  (no se pudo actualizar precios: {e})")
   439	    try:
   440	        mercados = json.load(open(mp.SALIDA, encoding="utf-8"))["mercados"]
   441	    except Exception:
   442	        print("  (sin mercado_activo.json)")
   443	        return False
   444	    _, candidatas = senal_vivo.evaluar(m["avg7"], m["v2"], m["ajuste"],
   445	                                       m["lam48"], mercados, estado["paso"])
   446	    candidatas = [c for c in candidatas if c["tipo"] == "48h"]
   447	    if not candidatas:
   448	        print(f"  (sin señal 48 h → no se abre apuesta real · paso {estado['paso']})")
   449	        return False
   450	    # Elegir la MEJOR ventana entre TODAS las disponibles (mayor EV)
   451	    for _c in candidatas:
   452	        _p = _c["p_modelo"] if _c["lado"] == "YES" else (1 - _c["p_modelo"])
   453	        _c["_ev"] = round(_p * _c["cuota"], 3)
   454	    # Elegir la mejor ventana LIBRE (sin duplicados con otros bots)
   455	    c = None
   456	    for _c in sorted(candidatas, key=lambda x: -x["_ev"]):
   457	        ocup = ventana_ocupada(_c["slug"], _c["bin_titulo"])
   458	        if ocup:
   459	            print(f"  · {_c['bin_titulo']} {_c['lado']} ya ocupada por {ocup} → saltando")
   460	            continue
   461	        c = _c
   462	        break
   463	    if c is None:
   464	        print("  · todas las ventanas con señal están ocupadas por otros bots")
   465	        return False
   466	    print(f"  · {len(candidatas)} ventana(s) con señal · elegida la de mayor EV libre: "
   467	          f"{c['bin_titulo']} {c['lado']} · EV {c['_ev']:.2f}")
   468	
   469	    # ---- salvaguardas
   470	    if estado["paso"] > 7:
   471	        print("  [BLOQUEADO] paso > 7: stop de ciclo. Reinicia el ciclo.")
   472	        return False
   473	    fee = cfg.get("fee_pct", 0.0)
   474	    coste_total = c["stake"] * (1 + fee)
   475	    if coste_total > cfg.get("bankroll", BANKROLL) * 0.5:
   476	        print(f"  [BLOQUEADO] el stake ${c['stake']:.2f} supera el 50% del "
   477	              f"bankroll ${cfg.get('bankroll', BANKROLL):.0f}.")
   478	        return False
   479	
   480	    # ---- orden
   481	    client = get_client() if not dry else None
   482	    tokens = None
   483	    if not dry:
   484	        tokens = token_id_para_bin(c["slug"], c["bin_titulo"])
   485	        if not tokens:
   486	            print(f"  [ERROR] no encontré el token del bin {c['bin_titulo']} "
   487	                  f"en {c['slug']}")
   488	            return False
   489	        # Saldo real: consultar la deposit wallet (wallet_address) ON-CHAIN,
   490	        # porque el saldo CLOB es del firmante y en deposit wallets los
   491	        # fondos están en la wallet de la cuenta (pUSD).
   492	        wallet = (cfg.get("wallet_address") or "").strip()
   493	        saldo_real = 0.0
   494	        # FUENTE PRINCIPAL (Polymarket V2, abril 2026): el colateral de
   495	        # trading (pUSD) vive DENTRO del CLOB (balance interno), no suelto
   496	        # on-chain en la wallet. get_balance_allowance devuelve el balance
   497	        # real del funder. El saldo on-chain solo se usa como respaldo.
   498	        saldo_clob, _ = verificar_saldo_usdc(client)
   499	        if saldo_clob is not None and saldo_clob > 0:
   500	            saldo_real = saldo_clob
   501	            print(f"  Saldo CLOB: ${saldo_real:.2f} pUSD")
   502	        elif wallet:
   503	            saldos = saldo_usdc_onchain(wallet, "polygon") or {}
   504	            saldo_real = (saldos.get("pUSD", 0) + saldos.get("USDC", 0)
   505	                          + saldos.get("USDC.e", 0))
   506	            print(f"  Saldo on-chain ({wallet[:10]}…): "
   507	                  f"pUSD ${saldos.get('pUSD', 0):.2f} · "
   508	                  f"USDC ${saldos.get('USDC', 0):.2f} · "
   509	                  f"USDC.e ${saldos.get('USDC.e', 0):.2f}")
   510	        else:
   511	            saldo_real = saldo_clob or 0.0
   512	        if saldo_real < coste_total:
   513	            print(f"  [BLOQUEADO] saldo insuficiente en la cuenta "
   514	                  f"(${saldo_real:.2f} < ${coste_total:.2f}).")
   515	            print("  Deposita pUSD/USDC en Polymarket (dirección wallet_address).")
   516	            return False
   517	
   518	    token_id = (tokens[0] if c["lado"] == "YES" else tokens[1]) if tokens else "TOKEN_DEMO"
   519	    print(f"  → Orden {'SIMULADA' if dry else 'REAL'}: "
   520	          f"{c['mercado']} · {c['bin_titulo']} {c['lado']} "
   521	          f"@{c['precio']:.3f} (cuota {c['cuota']:.2f}) · "
   522	          f"size {c['stake']:.2f} USDC · token {token_id[:12]}…")
   523	    order_id = None
   524	    if dry:
   525	        print("  (modo seco: no se envió nada)")
   526	    else:
   527	        try:
   528	            from py_clob_client_v2.clob_types import OrderArgs
   529	            # SDK V2: el 'size' de OrderArgs son SHARES, no dólares.
   530	            # stake $X a precio P → shares = X/P (redondeo a 2 dec).
   531	            size_shares = round(c["stake"] / c["precio"], 2)
   532	            if size_shares < 5:
   533	                print(f"  [BLOQUEADO] tamaño {size_shares} shares < mínimo 5 "
   534	                      f"(stake ${c['stake']:.2f} a precio {c['precio']:.3f}).")
   535	                return False
   536	            print(f"  (stake ${c['stake']:.2f} → {size_shares} shares a "
   537	                  f"{c['precio']:.3f})")
   538	            # limpiar órdenes abiertas previas (restos de runs cancelados)
   539	            try:
   540	                from py_clob_client_v2.clob_types import OrderPayload
   541	                _abiertas = client.get_open_orders() or []
   542	                for _o in _abiertas:
   543	                    try:
   544	                        client.cancel_order(OrderPayload(orderID=_o.get("id")))
   545	                    except Exception:
   546	                        pass
   547	                if _abiertas:
   548	                    print(f"  · canceladas {len(_abiertas)} órdenes previas sin cerrar")
   549	            except Exception as e:
   550	                print(f"  (aviso limpiando órdenes previas: {e})")
   551	            resp = client.create_and_post_order(
   552	                OrderArgs(price=c["precio"], size=size_shares,
   553	                          side="BUY", token_id=token_id))
   554	            order_id = resp.get("orderID") or resp.get("order_id")
   555	            print(f"  Orden enviada: {order_id}  (respuesta: {str(resp)[:120]})")
   556	            # NOTIFICAR INMEDIATAMENTE (no esperar al fill)
   557	            try:
   558	                notificar.enviar(
   559	                    f"💰 ORDEN REAL enviada\n"
   560	                    f"Mercado: {c['slug']}\nBin {c['bin_titulo']} · {c['lado']} "
   561	                    f"@ {c['precio']:.3f} (cuota {c['cuota']:.2f})\n"
   562	                    f"Paso {estado['paso']} · stake ${c['stake']:.2f} · vigilando fill (60 min)\n"
   563	                    f"{saldo_ntfy.saldo_real_texto()}",
   564	                    titulo="💰 Apuesta REAL abierta",
   565	                    etiqueta="moneybag")
   566	            except Exception as e:
   567	                print(f"  [aviso] notif inmediata: {e}")
   568	        except Exception as e:
   569	            print(f"  [ERROR] no se pudo enviar la orden: {e}")
   570	            return False
   571	        # chequeo rápido del fill (sin bloquear el bot: la vigilancia
   572	        # continúa en cada pasada vía vigilar_orden_pendiente)
   573	        llenada = False
   574	        if order_id:
   575	            for _intento in range(3):
   576	                try:
   577	                    detalle = client.get_order(order_id)
   578	                    st = (detalle.get("status") or "").lower()
   579	                    sz = float(detalle.get("size_matched", 0) or 0)
   580	                    if st in ("matched", "filled") or sz > 0:
   581	                        llenada = True
   582	                        break
   583	                    if st == "cancelled":
   584	                        break
   585	                except Exception:
   586	                    pass
   587	                time.sleep(10)
   588	            if llenada:
   589	                try:
   590	                    notificar.enviar(
   591	                        f"✅ ORDEN REAL LLENADA (apuesta activa)\n"
   592	                        f"Mercado: {c['slug']}\nBin {c['bin_titulo']} · {c['lado']} "
   593	                        f"@ {c['precio']:.3f} (cuota {c['cuota']:.2f})\n"
   594	                        f"Stake ${c['stake']:.2f} · se ejecutará hasta {c['ventana'][1].isoformat()[:16]}\n"
   595	                        f"{saldo_ntfy.saldo_real_texto()}",
   596	                        titulo="[REAL] ✅ Apuesta EJECUTADA",
   597	                        etiqueta="white_check_mark")
   598	                except Exception as e:
   599	                    print(f"  [aviso] notif llenada: {e}")
   600	            else:
   601	                print(f"  ⏳ Orden {order_id[:14]}… pendiente de llenado "
   602	                      f"(se vigilará cada pasada, máx {FILL_TIMEOUT_MIN} min)")
   603	
   604	    estado["activa"] = {"slug": c["slug"], "fecha": datetime.now(ET).strftime("%Y-%m-%d"),
   605	                        "bin_titulo": c["bin_titulo"], "lo": c["lo"],
   606	                        "hi": (c["hi"] if c["hi"] != math.inf else None),
   607	                        "lado": c["lado"], "precio": round(c["precio"], 4),
   608	                        "cuota": round(c["cuota"], 2), "p_modelo": round(c["p_modelo"], 4),
   609	                        "paso": estado["paso"], "stake": c["stake"],
   610	                        "motor": c.get("motor", "motor_v1_martingala_fijo"),
   611	                        "ev": c.get("ev"),
   612	                        "order_id": order_id, "token_id": token_id,
   613	                        "pendiente": bool(order_id) and not llenada,
   614	                        "fecha_orden_ts": time.time(),
   615	                        "ventana_fin": c["ventana"][1].isoformat()}
   616	    guardar_estado(estado)
   617	    marcar_ventana(c["slug"], c["bin_titulo"], c["ventana"][1].isoformat())
   618	    print(f"  ✔ ABIERTA apuesta REAL (o simulada): {c['bin_titulo']} {c['lado']} "
   619	          f"a {c['precio']:.3f} · paso {estado['paso']} · stake ${c['stake']:.2f}")
   620	    return True
