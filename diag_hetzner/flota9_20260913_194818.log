   174	def token_id_para_bin(slug, bin_titulo):
   175	    """Devuelve (token_id_YES, token_id_NO) del bin pedido, o None."""
   176	    r = subprocess.run(["curl", "-s", "--max-time", "40",
   177	                        f"https://gamma-api.polymarket.com/events?slug={slug}"],
   178	                       capture_output=True, text=True, encoding="utf-8", errors="replace")
   179	    try:
   180	        evs = json.loads(r.stdout)
   181	        ev = evs[0]
   182	        for m in ev.get("markets", []):
   183	            if (m.get("groupItemTitle") or "") == bin_titulo:
   184	                tokens = json.loads(m.get("clobTokenIds") or "[]")
   185	                if len(tokens) >= 2:
   186	                    return tokens[0], tokens[1]
   187	    except Exception:
   188	        pass
   189	    return None
