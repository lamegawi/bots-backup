   740	def probar_orden():
   741	    """PRUEBA SEGURA del pipeline de órdenes reales (firma V2):
   742	    coloca una orden límite de 5 shares a precio 0.01 (máx. 5 céntimos) en el primer bin del
   743	    mercado 48h activo — es un precio imposible (los bins cotizan ≥ 0.10),
   744	    por lo que NO se llenará nunca. Si se llenara, costaría 1 céntimo.
   745	    Sirve para validar que la firma de órdenes V2 funciona antes de
   746	    confiar dinero real. La orden se cancela a los 2 minutos."""
   747	    print("Prueba de orden SEGURA (precio 0.01, tamaño $0.01 — no se llenará).")
   748	    cfg = cargar_config()
   749	    client = get_client()
   750	    try:
   751	        mercados = json.load(open(mp.SALIDA, encoding="utf-8"))["mercados"]
   752	    except Exception:
   753	        print("  (sin mercado_activo.json: ejecuta primero el bot en papel)")
   754	        return
   755	    ahora = datetime.now(timezone.utc)
   756	    activo = next((m for m in mercados
   757	                   if not m["cerrado"] and m["tipo"] == "48h"
   758	                   and m.get("fin_iso")
   759	                   and datetime.fromisoformat(m["fin_iso"]) > ahora), None)
   760	
   761	    if not activo:
   762	        print("  (no hay mercado 48h abierto ahora mismo)")
   763	        return
   764	    # elegir el primer bin CON PRECIO REAL (no los bins muertos a 0.000)
   765	    b = next((x for x in activo["bins"] if (x.get("precio_yes") or 0) >= 0.02),
   766	             activo["bins"][0])
   767	    tokens = token_id_para_bin(activo["slug"], b["titulo"])
   768	    if not tokens:
   769	        print(f"  (no encontré tokens para {b['titulo']})")
   770	        return
   771	    token_id = tokens[0]  # YES
   772	    try:
   773	        from py_clob_client_v2.clob_types import OrderArgs
   774	        resp = client.create_and_post_order(
   775	            OrderArgs(token_id=token_id, price=0.01, size=5, side="BUY"))
   776	        oid = resp.get("orderID") or resp.get("order_id")
   777	        print(f"  ✔ Orden de prueba enviada: {oid}")
   778	        print("  Si no hay error, la firma V2 funciona → puedes activar confirmado:true.")
   779	        time.sleep(8)
   780	        try:
   781	            client.cancel_order(oid)
   782	            print("  ✔ Orden de prueba cancelada (sin riesgo).")
   783	        except Exception as e:
   784	            print(f"  (aviso al cancelar: {e})")
   785	    except Exception as e:
   786	        print(f"  ✖ ERROR al enviar la orden de prueba: {e}")
   787	        print("  → Si es un error de firma/dominio, el SDK V2 no está bien instalado")
   788	        print("    o las credenciales no corresponden. Pega el error aquí.")
   789	
