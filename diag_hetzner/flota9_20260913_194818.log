   791	def main():
   792	    ap = argparse.ArgumentParser(description="Trading real en Polymarket (con salvaguardas)")
   793	    ap.add_argument("--simular", action="store_true", help="modo seco (no envía órdenes)")
   794	    ap.add_argument("--actualizar", action="store_true", help="refrescar precios")
   795	    ap.add_argument("--excel", action="store_true", help="actualizar Excel historial")
   796	    ap.add_argument("--probar-orden", action="store_true",
   797	                    help="prueba SEGURA de orden real (0.01$ a precio 0.01, no se llena)")
   798	    args = ap.parse_args()
   799	    for _s in (sys.stdout, sys.stderr):
   800	        try:
   801	            _s.reconfigure(encoding="utf-8", errors="replace")
   802	        except Exception:
   803	            pass
   804	    if args.probar_orden:
   805	        probar_orden()
   806	        return
   807	    pasada_real(dry=args.simular, actualizar=args.actualizar, excel=args.excel)
