   260	def evento_resuelto(slug):
   261	    r = subprocess.run(["curl", "-s", "--max-time", "40",
   262	                        f"https://gamma-api.polymarket.com/events?slug={slug}"],
   263	                       capture_output=True, text=True, encoding="utf-8", errors="replace")
   264	    try:
   265	        evs = json.loads(r.stdout)
   266	        ev = evs[0]
   267	        if not ev.get("closed"):
   268	            return False, None
   269	        for m in ev.get("markets", []):
   270	            try:
   271	                p = json.loads(m.get("outcomePrices") or "[]")
   272	            except Exception:
   273	                continue
   274	            if p and p[0] == "1":
   275	                return True, m.get("groupItemTitle")
   276	    except Exception:
   277	        pass
   278	    return False, None
