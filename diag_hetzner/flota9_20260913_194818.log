   360	def resolver(estado, fee_pct=0.0):
   361	    """Cierra la apuesta real activa si su mercado ya se resolvió.
   362	    (Polymarket canjea automáticamente las shares ganadoras → el USDC
   363	    vuelve solo al wallet; aquí solo anotamos el resultado.)"""
   364	    act = estado.get("activa")
   365	    if not act:
   366	        return False
   367	    resuelto, winner_titulo = evento_resuelto(act["slug"])
   368	    if not resuelto or not winner_titulo:
   369	        return False
   370	    win = mp.parse_bin(winner_titulo)
   371	    if not win:
   372	        return False
   373	    w_lo, w_hi = win
   374	    w_hi = None if w_hi == float("inf") else w_hi
   375	    if act["lado"] == "YES":
   376	        ok = (w_lo == act["lo"] and w_hi == act["hi"])
   377	    else:
   378	        ok = not (w_lo == act["lo"] and w_hi == act["hi"])
   379	    fee = round(act["stake"] * fee_pct, 2)
   380	    if ok:
   381	        benef = round(act["stake"] * (act["cuota"] - 1) - fee, 2)
   382	        estado["saldo"] += benef
   383	        res = "G"
   384	        estado["paso"] = 1
   385	    else:
   386	        benef = -round(act["stake"] + fee, 2)
   387	        estado["saldo"] += benef
   388	        res = "P"
   389	        estado["paso"] = 1 if act["paso"] >= 7 else act["paso"] + 1
   390	    registro = {"id": uuid.uuid4().hex[:12], "fecha": act["fecha"],
   391	                "mercado": act.get("slug", "—"), "bin": act["bin_titulo"],
   392	                "lado": act["lado"], "precio": act["precio"], "cuota": act["cuota"],
   393	                "p_modelo": act["p_modelo"], "paso": act["paso"],
   394	                "stake": round(act["stake"], 2), "real": winner_titulo,
   395	                "motor": act.get("motor", "motor_v1_martingala_fijo"),
   396	                "ev": act.get("ev"),
   397	                "resultado": res, "beneficio": benef,
   398	                "saldo": round(estado["saldo"], 2)}
   399	    estado["historial"].append(registro)
   400	    estado["activa"] = None
   401	    escribir_historial(estado["historial"])
   402	    liberar_ventana(act.get("slug", ""), act.get("bin_titulo", ""))
   403	    guardar_estado(estado)
   404	    print(f"  ✔ RESUELTA apuesta REAL del {act['fecha']}: {act['bin_titulo']} "
   405	          f"{act['lado']} → ganador {winner_titulo} → {res} ${benef:+.2f} "
   406	          f"(saldo ${estado['saldo']:.2f})")
   407	    try:
   408	        notificar.enviar(
   409	            f"{'✅ GANADA' if res == 'G' else '❌ PERDIDA'}  ${benef:+.2f} (REAL)\n"
   410	            f"Bin {act['bin_titulo']} · {act['lado']} · ganador real {winner_titulo}\n"
   411	            f"Stake ${act['stake']:.2f} · saldo de la operación ${benef:+.2f}\n"
   412	            f"{saldo_ntfy.saldo_real_texto()}",
   413	            titulo="💰 Apuesta REAL cerrada",
   414	            etiqueta="white_check_mark" if res == "G" else "x")
   415	    except Exception:
   416	        pass
   417	    return True
