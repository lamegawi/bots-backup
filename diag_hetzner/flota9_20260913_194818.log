   109	def parse_bin(question):
   110	    """Extrae [lo, hi] de 'Will Elon Musk post 140-159 tweets from ...'."""
   111	    m = re.search(r"post\s+<?(\d+)-(\d+)\s+tweets", question or "")
   112	    if m:
   113	        return int(m.group(1)), int(m.group(2))
   114	    m = re.search(r"post\s+<(\d+)\s+tweets", question or "")
   115	    if m:
   116	        return 0, int(m.group(1)) - 1
   117	    return None
