   192	def saldo_usdc_onchain(direccion, red="polygon"):
   193	    """Consulta el saldo de tokens de una dirección directamente en la
   194	    blockchain (sin API key, vía RPC público). Es la fuente de verdad.
   195	    Devuelve dict {simbolo: float} o None si no se pudo consultar.
   196	    IMPORTANTE (Polymarket V2, abril 2026): el colateral de trading es
   197	    pUSD (0xC011a7E1...), no USDC. Los depósitos se convierten a pUSD."""
   198	    rpcs = {
   199	        "polygon": ["https://polygon-rpc.com", "https://1rpc.io/matic",
   200	                    "https://rpc.ankr.com/polygon"],
   201	        "ethereum": ["https://eth.llamarpc.com", "https://cloudflare-eth.com",
   202	                     "https://rpc.ankr.com/eth"],
   203	    }
   204	    # tokens por red: (símbolo, contrato, decimales)
   205	    tokens = {
   206	        "polygon": [
   207	            ("pUSD", "0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB", 6),   # colateral V2
   208	            ("USDC.e", "0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174", 6),  # puenteado
   209	            ("USDC", "0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359", 6),    # nativo
   210	            ("POL", "0x455e53CBB86018Ac2B8092FdCd39d8444aFFC3F6", 18),    # gas
   211	        ],
   212	        "ethereum": [
   213	            ("USDC", "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", 6),
   214	        ],
   215	    }
   216	    direccion = (direccion or "").lower().strip()
   217	    if not direccion.startswith("0x") or len(direccion) != 42:
   218	        return None
   219	    data = "0x70a08231" + "0" * 24 + direccion[2:]
   220	    resultado = {}
   221	    for simbolo, contrato, decimales in tokens[red]:
   222	        body = json.dumps({"jsonrpc": "2.0", "method": "eth_call",
   223	                           "params": [{"to": contrato, "data": data}, "latest"],
   224	                           "id": 1})
   225	        for rpc in rpcs[red]:
   226	            try:
   227	                out = subprocess.run(
   228	                    ["curl", "-s", "--max-time", "12", "-X", "POST", rpc,
   229	                     "-H", "Content-Type: application/json", "-d", body],
   230	                    capture_output=True, text=True,
   231	                    encoding="utf-8", errors="replace").stdout
   232	                r = json.loads(out)
   233	                if "result" in r and r["result"] not in ("0x", "0x0", None):
   234	                    resultado[simbolo] = int(r["result"], 16) / (10 ** decimales)
   235	                    break
   236	            except Exception:
   237	                continue
   238	    return resultado if resultado else None
   239	
