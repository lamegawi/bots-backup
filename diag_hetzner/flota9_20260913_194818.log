   927	            motivo = (f"p={p_actual:.0%}<{FIXWIN_P_ABANDONO:.0%} "
   928	                      f"-> {mejor['titulo']} p={p_mejor:.0%}")
   929	            cerrar_anticipado(estado, motivo, dry=dry)
