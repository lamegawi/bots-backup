    95	def get_client(signature_type=None):
    96	    """Cliente CLOB (import diferido: solo se necesita para dinero real).
    97	    IMPORTANTE (Polymarket V2, 28-abr-2026): se necesita el SDK V2:
    98	    pip install py-clob-client-v2
    99	    FIRMAS SMART WALLET: si tu cuenta se creó por email (deposit/proxy
   100	    wallet), el firmante y el dueño de los fondos son distintos. Hay que
   101	    usar signature_type=1 (POLY_PROXY) o 3 (POLY_1271). Por defecto se
   102	    usa POLY_PROXY cuando hay wallet_address (funder); puedes forzarlo
   103	    con el campo "signature_type" (0-3) en config_real.json."""
   104	    try:
   105	        from py_clob_client_v2.client import ClobClient
   106	        from py_clob_client_v2.clob_types import ApiCreds
   107	        from py_clob_client_v2 import SignatureTypeV2
   108	    except ImportError as e:
   109	        sys.exit(f"Falta el SDK V2 de Polymarket ({e}).\n"
   110	                 f"Ejecuta:  python -m pip install py-clob-client-v2")
   111	    cfg = cargar_config()
   112	    signer = (cfg.get("wallet_private_key") or "").strip()
   113	    if not signer:
   114	        sys.exit("Sin clave privada del firmante: en config_real.json pon "
   115	                 "wallet_private_key (la clave privada exportada en "
   116	                 "https://reveal.magic.link/polymarket para cuentas por email).")
   117	    kwargs = {}
   118	    if cfg.get("api_key") and cfg.get("api_secret") and cfg.get("api_passphrase"):
   119	        kwargs["creds"] = ApiCreds(cfg["api_key"], cfg["api_secret"],
   120	                                   cfg["api_passphrase"])
   121	    wallet = (cfg.get("wallet_address") or cfg.get("funder_address") or "").strip()
   122	    if wallet:
   123	        kwargs["funder"] = wallet
   124	    if signature_type is None:
   125	        signature_type = cfg.get("signature_type")
   126	    if signature_type is None:
   127	        # auto: smart wallet (funder distinto del signer) → POLY_PROXY; EOA puro → EOA
   128	        signature_type = int(SignatureTypeV2.POLY_PROXY) if wallet else int(SignatureTypeV2.EOA)
   129	    kwargs["signature_type"] = int(signature_type)
   130	    client = ClobClient(HOST, chain_id=137, key=signer, **kwargs)
   131	    if "creds" not in kwargs:
   132	        try:
   133	            creds = client.derive_api_key()
   134	            client.set_api_creds(creds)
   135	            print("  · Credenciales CLOB derivadas automáticamente de la clave privada.")
   136	        except Exception as e:
   137	            print(f"  [aviso] no se pudieron derivar credenciales API: {e}")
   138	    return client
