   813	# FIXWIN_ARENA (30/08): reposicionamiento inteligente entre ventanas
   814	# ================================================================
   815	FIXWIN_P_ABANDONO = 0.35   # cierra la activa si p_modelo baja de este umbral
   816	FIXWIN_P_GANADOR  = 0.68   # solo si hay bin alternativo con p >= este umbral
   817	FIXWIN_CIERRE_H   = {"48h": 6.0, "semanal": 12.0, "mensual": 24.0}  # h ventana cierre
   818	FIXWIN_REENTRADA  = 0.30   # % de ENTRADA_MAX_H que debe quedar para reentrada media
