-- 5) MENSUAL: el servicio vive desde las 07:08, pero no hay posiciones de septiembre
     # /etc/systemd/system/poly-mensual.service
     [Unit]
     Description=Bot Polymarket Elon MENSUAL (v1)
     After=network-online.target
     Wants=network-online.target
     StartLimitIntervalSec=0
     
     [Service]
     Type=simple
     User=root
     WorkingDirectory=/opt/polymarket/bot-polymarket-elon-mensual
     EnvironmentFile=/etc/polymarket.env
     ExecStart=/usr/bin/python3 bot_mensual.py --loop --intervalo 5 --excel --modo real
     Restart=always
     TimeoutStartSec=300
     RestartSec=30
     StandardOutput=append:/var/log/poly-mensual.log
     StandardError=append:/var/log/poly-mensual.log
     
     [Install]
     WantedBy=multi-user.target
