#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
recoger_tweets_rapidapi.py — tweets para 3 bots (Elon, Trump, Zelenskyy)
========================================================================
USA: twitterapi.io (endpoint /user/last_tweets — /user/tweets marca a Elon como 'suspended' falsamente)

USO:
  export TWITTERAPI_KEY=xxx
  python3 recoger_tweets_rapidapi.py --bot elon
  python3 recoger_tweets_rapidapi.py --bot all
"""
import os, sys, json, csv, argparse, urllib.request, urllib.error
from datetime import datetime, timedelta, timezone
from collections import defaultdict

API_HOST = "api.twitterapi.io"
API_KEY = os.environ.get("TWITTERAPI_KEY", "").strip()

if not API_KEY:
    sys.exit("❌ ERROR: configura TWITTERAPI_KEY (export TWITTERAPI_KEY=xxx)")

BOTS = {
    "elon": ("elonmusk", "/opt/polymarket/bot-polymarket-elon", "datos_elon.csv"),
    "trump": ("realDonaldTrump", "/opt/polymarket/bot-polymarket-trump", "datos_trump.csv"),
    "zelenskyy": ("ZelenskyyUa", "/opt/polymarket/bot-polymarket-zelenskyy", "datos_zelen.csv"),
}

# Endpoint correcto (no usar /user/tweets, marca Elon como suspended)
def fetch_user_last_tweets(username):
    url = f"https://{API_HOST}/twitter/user/last_tweets?userName={username}"
    headers = {
        "X-API-Key": API_KEY,
        "Content-Type": "application/json",
        "User-Agent": "Mozilla/5.0"
    }
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read())
        return data.get("data", data)

def parse_count(data):
    """Cuenta tweets por día (UTC)."""
    counts = defaultdict(int)
    tweets = data.get("tweets", [])
    if not isinstance(tweets, list):
        return {}
    
    for t in tweets:
        created = t.get("createdAt") or t.get("created_at") or t.get("created")
        if not created:
            continue
        try:
            dt = None
            for fmt in ["%a %b %d %H:%M:%S %z %Y", "%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%dT%H:%M:%SZ",
                       "%Y-%m-%dT%H:%M:%S.%f+00:00", "%Y-%m-%dT%H:%M:%S+00:00"]:
                try:
                    dt = datetime.strptime(created, fmt)
                    if dt.tzinfo is None:
                        dt = dt.replace(tzinfo=timezone.utc)
                    break
                except:
                    continue
            if dt is None:
                continue
            # Solo últimos 30 días
            cutoff = datetime.now(timezone.utc) - timedelta(days=30)
            if dt < cutoff:
                continue
            fecha = dt.strftime("%Y-%m-%d")
            counts[fecha] += 1
        except:
            continue
    return dict(sorted(counts.items()))

def update_csv(csv_path, counts):
    rows = {}
    if os.path.exists(csv_path):
        with open(csv_path, encoding="utf-8") as f:
            for r in csv.DictReader(f):
                try: rows[r["fecha"]] = int(r["tweets"])
                except: pass
    rows.update(counts)
    with open(csv_path, "w", encoding="utf-8", newline="") as f:
        w = csv.writer(f)
        w.writerow(["fecha", "tweets"])
        for fecha in sorted(rows):
            w.writerow([fecha, rows[fecha]])
    return len(counts)

